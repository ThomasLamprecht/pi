+/** Node 20-compatible globSync polyfill: fs.globSync is Node 22+ only. */
+function globSync(pattern: string, options: { cwd: string }): string[] {
+	const results: string[] = [];
+	function walk(dir: string): void {
+		for (const entry of readdirSync(dir, { withFileTypes: true })) {
+			const fullPath = join(dir, entry.name);
+			const relPath = relative(options.cwd, fullPath);
+			if (entry.isDirectory()) walk(fullPath);
+			if (minimatch(relPath, pattern)) results.push(relPath);
+		}
+	}
+	walk(options.cwd);
+	return results;
+}
